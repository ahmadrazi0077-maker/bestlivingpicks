# Copy to .env and fill in your Supabase project values.
# NEVER commit a real .env file.

# Supabase project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=https://cvzxargnkrbsxwrgpqet.supabase.co

# Service role key (server-side only). Found in Supabase Dashboard → Project Settings → API.
# This key bypasses Row Level Security — keep it secret.
SUPABASE_SERVICE_ROLE_KEY=sb_publishable_mF0M4a7C-d8yYn3qJtLI8g_hb7ptifh

# Port the Express API listens on
PORT=4000

# Allowed frontend origin(s), comma-separated for multiple
FRONTEND_URL=http://localhost:3000
